package id.ac.stis.kotaksaran.service.impl;

import id.ac.stis.kotaksaran.dto.auth.LoginRequest;
import id.ac.stis.kotaksaran.dto.auth.RegisterRequest;
import id.ac.stis.kotaksaran.entity.Role;
import id.ac.stis.kotaksaran.entity.User;
import id.ac.stis.kotaksaran.exception.AppException;
import id.ac.stis.kotaksaran.repository.UserRepository;
import id.ac.stis.kotaksaran.security.jwt.JwtTokenProvider;
import id.ac.stis.kotaksaran.service.AuthService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.security.authentication.AuthenticationManager;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;

/**
 * Implementasi dari AuthService.
 * Berisi semua logika bisnis untuk registrasi dan login.
 */
@Service
public class AuthServiceImpl implements AuthService {

    @Autowired
    AuthenticationManager authenticationManager;

    @Autowired
    UserRepository userRepository;

    @Autowired
    PasswordEncoder passwordEncoder;

    @Autowired
    JwtTokenProvider tokenProvider;

    @Override
    public User registerUser(RegisterRequest registerRequest) {
        // 1. Cek apakah NIM sudah ada di database
        if(userRepository.existsByNim(registerRequest.getNim())) {
            throw new AppException("NIM sudah terdaftar!");
        }

        // 2. Buat objek User baru
        User user = new User();
        user.setNim(registerRequest.getNim());
        user.setNama(registerRequest.getNama());

        // 3. Enkripsi password menggunakan BCrypt
        user.setPassword(passwordEncoder.encode(registerRequest.getPassword()));

        // 4. Set role default sebagai MAHASISWA (sesuai Bab 1.3)
        user.setRole(Role.ROLE_MAHASISWA);

        // 5. Simpan user ke database
        return userRepository.save(user);
    }

    @Override
    public String authenticateUser(LoginRequest loginRequest) {
        // 1. Spring Security melakukan autentikasi
        // Ini akan memanggil CustomUserDetailsService kita
        Authentication authentication = authenticationManager.authenticate(
                new UsernamePasswordAuthenticationToken(
                        loginRequest.getNim(),
                        loginRequest.getPassword()
                )
        );

        // 2. Jika sukses, set autentikasi di SecurityContext
        SecurityContextHolder.getContext().setAuthentication(authentication);

        // 3. Generate JWT token
        String jwt = tokenProvider.generateToken(authentication);

        // 4. Kembalikan token
        return jwt;
    }
}
