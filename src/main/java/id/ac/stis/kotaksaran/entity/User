package id.ac.stis.kotaksaran.entity;

import jakarta.persistence.*;
import jakarta.persistence.Entity;
import jakarta.validation.constraints.Email;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Size;
import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;
import org.springframework.security.core.GrantedAuthority;
import org.springframework.security.core.authority.SimpleGrantedAuthority;
import org.springframework.security.core.userdetails.UserDetails;

import java.util.Collection;
import java.util.List;
import java.util.Set;

//Entitas User, mewakili tabel 'users' di database.
@Data 
@Builder
@NoArgsConstructor
@AllArgsConstructor
@Entity
@Table(name = "users")
public class User implements UserDetails {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @NotBlank(message = "NIM tidak boleh kosong")
    @Column(unique = true)
    @Size(min = 8, max = 10, message = "NIM harus 8-10 digit")
    private String nim; // Digunakan sebagai username untuk login

    @NotBlank(message = "Nama tidak boleh kosong")
    private String nama;

    @NotBlank(message = "Email tidak boleh kosong")
    @Email(message = "Format email tidak valid")
    @Column(unique = true)
    private String email;

    @NotBlank(message = "Password tidak boleh kosong")
    private String password;

    @NotNull
    @Enumerated(EnumType.STRING)
    private Role role;

    //Relasi One-to-Many: Satu User bisa punya banyak Saran
    @OneToMany(mappedBy = "pengirim", fetch = FetchType.LAZY)
    private Set<Saran> saranList; 
    @Override
    public Collection<? extends GrantedAuthority> getAuthorities() {
        return List.of(new SimpleGrantedAuthority(role.name()));
    }

    @Override
    public String getUsername() {
        // menggunakan NIM sebagai username untuk login
        return this.nim;
    }

     @Override
    public boolean isAccountNonExpired() {
        // 1. Periksa Role. Jika Admin, akun tidak pernah kedaluwarsa.
        if (this.role == Role.ROLE_ADMIN) {
            return true;
        }

        // 2. Periksa tanggal kedaluwarsa (5 tahun)
        LocalDateTime now = LocalDateTime.now();
        LocalDateTime expiryDate = this.createdAt.plusYears(5);

        // Akun valid (non-expired) jika 'sekarang' masih sebelum tanggal kedaluwarsa
        return now.isBefore(expiryDate);
    }

    @Override
    public boolean isAccountNonLocked() {
        return true;
    }

    @Override
    public boolean isCredentialsNonExpired() {
        return true;
    }

    @Override
    public boolean isEnabled() {
        return true;
    }
}

