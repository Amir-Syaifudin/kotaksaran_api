package id.ac.stis.kotaksaran.controller;

import id.ac.stis.kotaksaran.dto.ApiResponse;
import id.ac.stis.kotaksaran.dto.auth.JwtAuthenticationResponse;
import id.ac.stis.kotaksaran.dto.auth.LoginRequest;
import id.ac.stis.kotaksaran.dto.auth.RegisterRequest;
import id.ac.stis.kotaksaran.entity.User;
import id.ac.stis.kotaksaran.service.AuthService;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.servlet.support.ServletUriComponentsBuilder;

import java.net.URI;

/**
 * Controller untuk Modul Autentikasi (Publik).
 * endpoint ini harus bisa diakses tanpa token.
 */
@RestController
@RequestMapping("/api/auth")
@Tag(name = "1. Modul Autentikasi", description = "Endpoint publik untuk Registrasi dan Login.")
public class AuthController {

    @Autowired
    private AuthService authService;

    @Operation(summary = "Login Pengguna", description = "Mengautentikasi pengguna (Mahasiswa/Admin) berdasarkan NIM dan password. Mengembalikan JWT jika berhasil.")
    @PostMapping("/login")
    public ResponseEntity<?> authenticateUser(@Valid @RequestBody LoginRequest loginRequest) {
        // Panggil service untuk autentikasi dan generate token
        String jwt = authService.authenticateUser(loginRequest);
        // Kembalikan token dalam DTO JwtAuthenticationResponse
        return ResponseEntity.ok(new JwtAuthenticationResponse(jwt));
    }

    @Operation(summary = "Registrasi Mahasiswa Baru", description = "Mendaftarkan akun baru khusus untuk Mahasiswa (ROLE_MAHASISWA).")
    @PostMapping("/register")
    public ResponseEntity<?> registerUser(@Valid @RequestBody RegisterRequest registerRequest) {
        User result = authService.registerUser(registerRequest);
        URI location = ServletUriComponentsBuilder
                .fromCurrentContextPath().path("/api/users/{username}")
                .buildAndExpand(result.getNim()).toUri();
        return ResponseEntity.created(location)
                .body(new ApiResponse(true, "User registered successfully"));
    }
}
