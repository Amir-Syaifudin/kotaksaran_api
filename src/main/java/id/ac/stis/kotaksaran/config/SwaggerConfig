package id.ac.stis.kotaksaran.config;

import io.swagger.v3.oas.models.Components;
import io.swagger.v3.oas.models.OpenAPI;
import io.swagger.v3.oas.models.info.Info;
import io.swagger.v3.oas.models.security.SecurityRequirement;
import io.swagger.v3.oas.models.security.SecurityScheme;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/**
 * Konfigurasi ini bertujuan untuk menambahkan tombol "Authorize" di halaman Swagger UI, sehingga bisa memasukkan token JWT untuk menguji endpoint yang terproteksi.
 */
@Configuration
public class SwaggerConfig {

    @Bean
    public OpenAPI openAPI() {
        // Mendefinisikan skema keamanan "Bearer Token"
        final String securitySchemeName = "bearerAuth";
        
        return new OpenAPI()
                // Menambahkan definisi skema keamanan
                .components(
                        new Components()
                                .addSecuritySchemes(securitySchemeName,
                                        new SecurityScheme()
                                                .name(securitySchemeName)
                                                .type(SecurityScheme.Type.HTTP)
                                                .scheme("bearer")
                                                .bearerFormat("JWT")
                                )
                )
                .addSecurityItem(new SecurityRequirement().addList(securitySchemeName))
                // Informasi dasar API
                .info(new Info()
                        .title("API Kotak Saran Polstat STIS")
                        .description("Layanan Web Backend untuk aplikasi Kotak Saran Mahasiswa.")
                        .version("v1.0")
                );
    }
}